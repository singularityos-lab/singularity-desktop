#!/bin/sh

display="${DISPLAY:-:0}"
display="${display##*:}"
display="${display%%.*}"
case "$display" in
    ""|*[!0-9]*) display=0 ;;
esac

mkdir -p /tmp/.X11-unix
lock="/tmp/.X${display}-lock"
owner=""
if [ -r "$lock" ]; then
    read -r owner < "$lock"
fi
if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then
    rm -f "$lock"
    printf '%10d\n' "$$" > "$lock"
    chmod 0444 "$lock"
fi

exec /opt/singularity/bin/singularity-labwc-session "$@"
